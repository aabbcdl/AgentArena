{
  "name": "@agentarena/adapters",
  "version": "0.2.0",
  "description": "Agent adapters for AgentArena — 15 adapters: demo-fast/thorough/budget, codex, claude-code, cursor, gemini-cli, aider, copilot, kilo-cli, opencode, qwen-code, trae, augment",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentarena/core": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
