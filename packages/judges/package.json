{
  "name": "@agentarena/judges",
  "version": "0.2.0",
  "description": "Judge implementations for AgentArena — 15 types: command, test-result, lint-check, file-exists/contains/count, json-value/schema, glob, snapshot, directory-exists, regex-match, patch-validation, compilation, token-efficiency",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentarena/core": "workspace:*",
    "ajv": "8.20.0",
    "picomatch": "4.0.4"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/picomatch": "4.0.2"
  }
}
